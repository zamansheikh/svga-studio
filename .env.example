# Public site origin — used for canonical URLs, OG tags, sitemap, robots.
# Example: https://svga-compressor.vercel.app
NEXT_PUBLIC_SITE_URL=

# The studio lock. The tool pages (/edit, /icons) ask for this 4-digit PIN.
# Without it they stay locked for everyone.
STUDIO_PIN=
# Optional: any long random string. Signs the "unlocked" cookie; changing it
# (or the PIN) signs every device out.
STUDIO_SECRET=
